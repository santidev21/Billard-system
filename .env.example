# Environment Variables

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# JWT (min 32 bytes, use: openssl rand -base64 48)
JWT_KEY=change-me-jwt-secret-min-32-bytes

# Super Admin
SUPER_USERNAME=superadmin
SUPER_PASSWORD=CHANGE-ME-strong-password-min-8-chars

# .NET
ASPNETCORE_ENVIRONMENT=Production
AllowedHosts=billard.santidev21.tech;localhost

# Local camera bridge (optional) — IP cameras on the LAN, no vendor app needed.
# Run with: npm run camera:up   (see camera-bridge/README.md)
CAMERA_USER=admin
CAMERA_PASSWORD=
# CAMERA_SCAN_SUBNETS=192.168.1.0/24
# CAMERA_AUTO_H264=true
# BRIDGE_HOST=127.0.0.1
# ALLOWED_ORIGINS=https://billard.santidev21.tech,http://localhost:4200
